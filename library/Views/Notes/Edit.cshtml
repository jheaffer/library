@model Note
@{
    ViewData["Title"] = "Edit Note";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h2 class="fw-bold text-light mb-1">Edit Note</h2>
                <p class="text-muted small mb-4">Update the details of this note.</p>

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="NoteId" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control form-control-lg rounded-3 fs-6" />
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Body" class="form-label">Body</label>
                        <textarea asp-for="Body" class="form-control rounded-3 fs-6" rows="4"></textarea>
                        <span asp-validation-for="Body" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <button type="submit" class="btn btn-primary btn-lg px-4 rounded-pill fw-semibold shadow-sm">Save Changes</button>
                        <a asp-action="Index" class="btn btn-link text-decoration-none text-muted fw-semibold">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
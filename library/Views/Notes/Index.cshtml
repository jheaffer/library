@model List<Note>
@{
    ViewData["Title"] = "Notepad";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
        <div>
            <h1 class="fw-bold text-light mb-1">Notepad</h1>
            <p class="text-muted mb-0">Manage internal library notes, reminders, and tasks.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill fw-semibold">Add a note</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive mb-0">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3" style="width:4rem">#</th>
                        <th class="py-3">Title</th>
                        <th class="py-3">Body</th>
                        <th class="py-3">Created On</th>
                        <th class="text-end pe-4 py-3" style="width:12rem">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var note in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-secondary">@note.NoteId</td>
                            <td class="fw-bold text-light">@note.Title</td>
                            <td>
                                @if (!string.IsNullOrEmpty(note.Body))
                                {
                                    <span class="text-light">@note.Body</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-muted px-2 py-1">— No Content —</span>
                                }
                            </td>
                            <td class="text-secondary fw-semibold">@note.CreatedOn.ToString("yyyy-MM-dd")</td>
                            <td class="text-end pe-4">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@note.NoteId" class="btn btn-sm btn-outline-info fw-semibold px-3">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@note.NoteId" class="btn btn-sm btn-outline-danger fw-semibold px-3">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
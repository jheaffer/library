@model List<Note>
@{
    ViewData["Title"] = "Notepad";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
        <div>
            <h1 class="fw-bold text-light mb-1 font-monospace">⚡ // dev.notepad</h1>
            <p class="text-muted mb-0">Internal library scratchpad, tasks, and system reminders.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill fw-semibold">
            <i class="bi bi-plus-lg me-1"></i> New Note
        </a>
    </div>

    <!-- Notepad Grid Layout -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var note in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 position-relative notepad-card">
                    <!-- Notepad Top Binding Strip -->
                    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <span class="badge bg-info bg-opacity-10 text-info font-monospace px-2 py-1 rounded-2">
                            #@note.NoteId
                        </span>
                        <small class="text-muted font-monospace">@note.CreatedOn.ToString("yyyy-MM-dd")</small>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-light mb-3">@note.Title</h5>

                        <div class="card-text text-secondary flex-grow-1 p-3 rounded-3 mb-3 notepad-body font-monospace small">
                            @if (!string.IsNullOrEmpty(note.Body))
                            {
                                <p class="mb-0 text-light">@note.Body</p>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">— Empty note body —</span>
                            }
                        </div>

                        <!-- Actions Footer -->
                        <div class="d-flex justify-content-end gap-2 pt-2 border-top border-secondary border-opacity-25">
                            <a asp-action="Edit" asp-route-id="@note.NoteId" class="btn btn-sm btn-outline-info px-3 rounded-pill fw-semibold">Edit</a>
                            <a asp-action="Delete" asp-route-id="@note.NoteId" class="btn btn-sm btn-outline-danger px-3 rounded-pill fw-semibold">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0 text-white"><i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>Loans</h1>
        <p class="text-white-50 mb-0">@Model.Count total records, newest first</p>
    </div>
    <a asp-action="Borrow" class="btn btn-primary px-3">
        <i class="bi bi-plus-circle me-1"></i> Borrow a book
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-warning border-opacity-50 shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-warning small text-uppercase fw-semibold">Books Out</div>
                    <div class="fs-3 fw-bold text-white">@Model.Count(l => l.Status == "Out")</div>
                </div>
                <i class="bi bi-book-half fs-2 text-warning opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-danger border-opacity-50 shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-danger small text-uppercase fw-semibold">Overdue</div>
                    <div class="fs-3 fw-bold text-white">@Model.Count(l => l.Status == "Overdue")</div>
                </div>
                <i class="bi bi-exclamation-triangle-fill fs-2 text-danger opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-success border-opacity-50 shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-success small text-uppercase fw-semibold">Returned</div>
                    <div class="fs-3 fw-bold text-white">@Model.Count(l => l.Status == "Returned")</div>
                </div>
                <i class="bi bi-check-circle-fill fs-2 text-success opacity-75"></i>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Member</th>
                    <th>Book</th>
                    <th>Loaned</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th class="text-end" style="width:9rem">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr>
                        <td class="fw-semibold text-white"><i class="bi bi-person me-1 text-white-50"></i>@loan.MemberName</td>
                        <td class="text-white"><i class="bi bi-book me-1 text-white-50"></i>@loan.BookTitle</td>
                        <td class="font-monospace text-white-50">@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                        <td class="font-monospace @(loan.Status == "Overdue" ? "text-danger fw-semibold" : "text-white-50")">
                            @(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))
                        </td>
                        <td>
                            @if (loan.Status == "Overdue")
                            {
                                <span class="badge rounded-pill bg-danger bg-opacity-25 text-danger border border-danger px-3">
                                    <i class="bi bi-clock-history me-1"></i>Overdue
                                </span>
                            }
                            else if (loan.Status == "Out")
                            {
                                <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning border border-warning px-3">
                                    <i class="bi bi-hourglass-split me-1"></i>Out
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-25 text-success border border-success px-3">
                                    <i class="bi bi-check2 me-1"></i>Returned
                                </span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (loan.ReturnedOn == null)
                            {
                                <form asp-action="Return" asp-route-id="@loan.LoanId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-arrow-return-left me-1"></i>Return
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

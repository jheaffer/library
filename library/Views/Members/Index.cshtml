@model List<Member>
@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0 text-white">Members</h1>
        <p class="text-white mb-0">@Model.Count members in the registry</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add a member
    </a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="text-end" style="width:4rem">#</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Member Type</th>
                    <th class="text-end text-nowrap">Books Out</th>
                    <th class="text-end" style="width:15rem">Actions</th>
                    <th class="text-end">Books out</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model)
                {
                    <tr>
                        <td class="text-end font-monospace text-muted">@member.MemberId</td>
                        <td class="fw-semibold text-white">@member.FullName</td>
                        <td>
                            <span class="badge">@(member.Email ?? "—")</span>
                        </td>
                        <td class="text-white-50">@member.MemberType</td>
                        <td class="text-end text-white">@member.OpenLoans</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-primary">Loans</a>
                            <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                        <td class="text-end">@member.OpenLoans</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

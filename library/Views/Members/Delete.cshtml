@model Member
@{
    ViewData["Title"] = "Delete a member";
}

<div class="mx-auto" style="max-width:38rem">
    <h1 class="mb-3 text-white"><i class="bi bi-person-x-fill me-2 text-danger"></i>Delete a member</h1>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger border-danger d-flex align-items-center gap-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-shield-exclamation fs-3 text-danger"></i>
            <div>
                <div class="fw-bold">Action Blocked</div>
                <div>@ViewBag.Error</div>
            </div>
        </div>
    }

    <div class="card shadow-sm border-danger border-opacity-50">
        <div class="card-body p-4">
            <p class="text-warning fw-semibold mb-3">
                <i class="bi bi-exclamation-triangle me-1"></i> Are you sure you want to permanently delete this member?
            </p>

            <dl class="row mb-4 p-3 rounded border border-secondary border-opacity-25">
                <dt class="col-4 text-white-50">Full Name</dt>
                <dd class="col-8 text-white fw-semibold">@Model.FullName</dd>

                <dt class="col-4 text-white-50">Email</dt>
                <dd class="col-8 text-white">@(Model.Email ?? "—")</dd>

                <dt class="col-4 text-white-50 mb-0">Member Type</dt>
                <dd class="col-8 text-white mb-0">@Model.MemberType</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post" class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Cancel
                </a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i> Delete Member
                </button>
            </form>
        </div>
    </div>
</div>

@model MemberDetails
@{
    ViewData["Title"] = Model.Member.FullName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to members
    </a>
</div>

<div class="card shadow-sm mb-4 border-primary border-opacity-25">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 p-4">
        <div>
            <span class="badge bg-primary bg-opacity-25 text-primary border border-primary mb-2">@Model.Member.MemberType</span>
            <h1 class="h3 mb-1 text-white">@Model.Member.FullName</h1>
            <p class="text-white-50 mb-0">
                <i class="bi bi-envelope me-1"></i> @(Model.Member.Email ?? "no email")
            </p>
        </div>
        <div class="d-flex gap-3 text-center">
            <div class="px-3 py-2 rounded border border-secondary border-opacity-25">
                <div class="small text-white-50">Currently Out</div>
                <div class="fs-4 fw-bold text-warning">@Model.Loans.Count(l => l.ReturnedOn == null)</div>
            </div>
            <div class="px-3 py-2 rounded border border-secondary border-opacity-25">
                <div class="small text-white-50">Total Borrowed</div>
                <div class="fs-4 fw-bold text-white">@Model.Loans.Count</div>
            </div>
        </div>
    </div>
</div>

<h2 class="h5 text-white mb-3"><i class="bi bi-collection me-2 text-primary"></i>Loan History</h2>

@if (Model.Loans.Count == 0)
{
    <div class="card shadow-sm text-center p-5">
        <i class="bi bi-journal-x fs-1 text-white-50 mb-2"></i>
        <p class="text-white mb-0">This member has never borrowed a book.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var loan in Model.Loans)
        {
            var borderClass = loan.Status == "Overdue" ? "border-danger" : loan.Status == "Out" ? "border-warning" : "border-success";
            var badgeClass = loan.Status == "Overdue" ? "bg-danger bg-opacity-25 text-danger border-danger"
                           : loan.Status == "Out" ? "bg-warning bg-opacity-25 text-warning border-warning"
                           : "bg-success bg-opacity-25 text-success border-success";

            <div class="col-md-6">
                <div class="card shadow-sm h-100 @borderClass border-opacity-50">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h3 class="h6 text-white mb-0"><i class="bi bi-book me-1 text-primary"></i>@loan.BookTitle</h3>
                            <span class="badge rounded-pill border @badgeClass">@loan.Status</span>
                        </div>
                        <div class="small text-white-50 d-flex flex-wrap gap-3 mt-3 pt-2 border-top border-secondary border-opacity-25">
                            <span><i class="bi bi-calendar-plus me-1"></i>Loaned: <strong class="text-white font-monospace">@(loan.LoanedOn.ToString("yyyy-MM-dd"))</strong></span>
                            <span><i class="bi bi-calendar-check me-1"></i>Returned: <strong class="text-white font-monospace">@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")</strong></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

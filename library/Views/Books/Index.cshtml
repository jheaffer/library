@model List<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">Books</h1>
        <p class="text-muted mb-0">@Model.Count books in the catalogue</p>
    </div>
    <!-- Task 9: Add a book button placed cleanly in the header -->
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add a book
    </a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="text-end" style="width:4rem">#</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th class="text-end">Price</th>
                    <th class="text-end" style="width:12rem">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td class="text-end font-monospace text-muted">@book.BookId</td>
                        <td class="fw-semibold">@book.Title</td>
                        <td>
                            <span class="badge">@(book.Category ?? "—")</span>
                        </td>
                        <td class="text-end">@(book.Price?.ToString("N2") ?? "—")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>